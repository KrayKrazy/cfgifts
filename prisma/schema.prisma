generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model CFGiftCustomer {
  id          String   @id @default(uuid())
  name        String
  email       String   @unique
  phone       String
  docType     String   // cpf ou cnpj
  docNumber   String
  fingerprint String?
  createdAt   DateTime @default(now())
  orders      CFGiftOrder[]
}

model CFGiftOrder {
  id                 String   @id @default(uuid())
  customerId         String
  customer           CFGiftCustomer @relation(fields: [customerId], references: [id])
  status             String   // PENDING_PAYMENT, PAID, CANCELLED
  paymentMethod      String   // credit_card, pix
  subtotal           Float
  shipping_price     Float
  total              Float
  installments       Int      @default(1)
  shipping_mode      String
  cep_destino        String
  address_street     String?
  address_number     String?
  address_complement String?
  address_district   String?
  address_city       String?
  address_state      String?
  carrier            String?
  idempotency_key    String?  @unique
  cakto_order_id     String?
  cakto_checkout_url String?
  cakto_ref          String?
  createdAt          DateTime @default(now())
}
